<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>YOLO Detection</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <div class="text-center mb-4">
        <h1>Perbandingan model yolov8n dan yolov9t pada deteksi sampah organik dan anorganik</h1>
    </div>

    <div class="card p-4">

        <form action="/upload" method="POST" enctype="multipart/form-data">

            <!-- INPUT GAMBAR -->
            <input 
                type="file" 
                name="image"
                class="form-control"
                required
            >

            <!-- BUTTON -->
            <button 
                type="submit"
                class="btn btn-primary mt-3"
            >
                Upload Gambar
            </button>

            <a href="/history" class="btn btn-success mt-3 ms-2">
    Lihat History
</a>

        </form>

    </div>

</div>

</body>
</html>



