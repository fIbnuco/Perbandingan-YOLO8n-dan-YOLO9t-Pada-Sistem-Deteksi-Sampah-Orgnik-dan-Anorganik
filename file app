from flask import Flask, render_template, request
from ultralytics import YOLO
import os
import cv2
import mysql.connector

app = Flask(__name__)

db = mysql.connector.connect(
    host = 'localhost',
    user = 'root',
    password = '',
    database = 'sampah',

)
cursor = db.cursor()

# =========================
# FOLDER UPLOAD
# =========================
UPLOAD_FOLDER = 'static/uploads'
app.config['UPLOAD_FOLDER'] = UPLOAD_FOLDER

# =========================
# LOAD MODEL
# =========================
model_v8 = YOLO("models/yolov8n.onnx", task="detect")
model_v9 = YOLO("models/yolov9t.onnx", task="detect")

# =========================
# HOME PAGE
# =========================
@app.route('/')
def home():
    return render_template('index.html')

# ====
# history
# ====

@app.route('/history')
def history() :
    sql = ""
    """
    SELECT *
    FROM detections
    ORDER BY id DESC
    """
    cursor.execute(sql)
    data = cursor.fetchall()

    return render_template(
        'history.html',
        data=data
    )
# =========================
# UPLOAD & DETECTION
# =========================
@app.route('/upload', methods=['POST'])
def upload():

    # =========================
    # CEK FILE
    # =========================
    if 'image' not in request.files:
        return 'Tidak ada file'

    file = request.files['image']

    if file.filename == '':
        return 'File kosong'

    # =========================
    # SIMPAN FILE
    # =========================
    filepath = os.path.join(
        app.config['UPLOAD_FOLDER'],
        file.filename
    )

    file.save(filepath)

    # =========================
    # YOLOv8 INFERENCE
    # =========================
    results_v8 = model_v8(filepath)

    # =========================
    # YOLOv9 INFERENCE
    # =========================
    results_v9 = model_v9(filepath)

    # =========================
    # CONFIDENCE YOLOv8
    # =========================
    detections_v8 = []

    for box in results_v8[0].boxes:

        conf = float(box.conf[0])

        detections_v8.append({
            "confidence": round(conf, 2)
        })

    # =========================
    # CONFIDENCE YOLOv9
    # =========================
    detections_v9 = []

    for box in results_v9[0].boxes:

        conf = float(box.conf[0])

        detections_v9.append({
            "confidence": round(conf, 2)
        })

    # =========================
    # HASIL IMAGE YOLOv8
    # =========================
    result_image_v8 = results_v8[0].plot()

    output_v8 = os.path.join(
        app.config['UPLOAD_FOLDER'],
        "v8_" + file.filename
    )

    cv2.imwrite(output_v8, result_image_v8)

    # =========================
    # HASIL IMAGE YOLOv9
    # =========================
    result_image_v9 = results_v9[0].plot()

    output_v9 = os.path.join(
        app.config['UPLOAD_FOLDER'],
        "v9_" + file.filename
    )

    cv2.imwrite(output_v9, result_image_v9)

# ========
# simpan ke database
# ========

    conf_v8 = detections_v8[0]['confidence'] if detections_v8 else 0
    conf_v9 = detections_v9[0]['confidence'] if detections_v9 else 0

    sql = """
    INSERT INTO detections
    (filename, confidence_v8, confidence_v9)
    VALUES (%s, %s, %s)
    """
    values = (
        file.filename,
        conf_v8,
        conf_v9
    )

    cursor.execute(sql, values)
    db.commit()

    # =========================
    # KIRIM KE HTML
    # =========================
    return render_template(
        'result.html',

        image_v8=output_v8,
        image_v9=output_v9,

        detections_v8=detections_v8,
        detections_v9=detections_v9
    )



# =========================
# RUN FLASK
# =========================
if __name__ == '__main__':
    app.run(debug=True)


    